# Same postgres:16-alpine digest as cvm-ansible-playbooks
# group_vars/all/image_versions.yaml postgres_alpine_image — pg_dump 16
# matches the Spilo-16 cluster, and runtime `apk add` is a non-starter in a
# TEE (the compose hash attests this image digest).
FROM postgres:16-alpine@sha256:a5074487380d4e686036ce61ed6f2d363939ae9a0c40123d1a9e3bb3a5f344b4

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# Install userland tooling at the versions pinned in pinned-packages.txt
# (regenerated by build-image.sh from the built image; CI fails on drift).
# Alpine has no snapshot archive: if the v3.23 repo rolls a pinned version
# out, the build fails loudly until the pins are refreshed — detected drift,
# never silent. socat serves the metrics textfile on :9464 (the busybox in
# this base is compiled without the httpd applet — verified). The second
# group refreshes libraries inherited from the base image to the pinned
# versions.
RUN --mount=type=bind,source=pinned-packages.txt,target=/tmp/pinned-packages.txt,ro \
    set -e; \
    to_install=""; \
    for pkg in aws-cli jq curl openssl coreutils socat \
               krb5-libs musl musl-utils zlib libuuid xz-libs libxml2 libxslt; do \
        ver=$(grep "^${pkg}=" /tmp/pinned-packages.txt | cut -d= -f2-); \
        if [ -z "$ver" ]; then \
            echo "No pinned version for ${pkg} in pinned-packages.txt" >&2; \
            exit 1; \
        fi; \
        to_install="$to_install ${pkg}=${ver}"; \
    done; \
    apk add --no-cache $to_install && \
    rm -rf /var/cache/apk/* /root/.cache

COPY --chmod=755 entrypoint.sh /app/entrypoint.sh
COPY --chmod=755 lib/ /app/lib/

# Normalize files that break byte-for-byte reproducibility.
RUN rm -rf /tmp/* /var/tmp/* && \
    find /etc/apk /lib/apk -name '*.lock' -delete 2>/dev/null || true

# Runtime state:
#   /run/backup  — tmpfs (64m) for pipeline tap files + captured stderr; no
#                  plaintext dump data is ever written anywhere.
#   /run/metrics — metrics textfile served on :9464 by socat.
RUN mkdir -p /run/backup /run/metrics

# 9464/tcp: Prometheus metrics (scraped by the in-CVM otelcol docker_sd job
# via the nearai.otel.* labels).
EXPOSE 9464/tcp

# Override the postgres base entrypoint — this image never runs a server;
# it is the backup daemon (PG_BACKUP_MODE=backup, default) or the one-shot
# restore drill driver (PG_BACKUP_MODE=restore).
ENTRYPOINT ["/app/entrypoint.sh"]
CMD []
